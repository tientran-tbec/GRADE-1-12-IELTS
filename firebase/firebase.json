{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "**/*.py", "**/*.bat"],
    "cleanUrls": false,
    "headers": [
      {"source": "**/*.html", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
      {"source": "**/*.@(js|css)", "headers": [{"key": "Cache-Control", "value": "public, max-age=300"}]},
      {"source": "**", "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "same-origin"},
        {"key": "X-Frame-Options", "value": "SAMEORIGIN"}
      ]}
    ],
    "rewrites": [{"source": "/api", "function": {"functionId": "api", "region": "asia-southeast1"}}]
  },
  "functions": [{"source": "functions", "codebase": "default", "ignore": ["node_modules", ".git", "*.log"]}],
  "firestore": {"rules": "firestore.rules", "indexes": "firestore.indexes.json"}
}
